      "html": "<button type=\"button\" class=\"ds-secondary\">添加文件</button>",
      "css": ".ds-secondary{font-family:inherit;font-size:0.8125rem;font-weight:500;line-height:1.4;min-height:2.5rem;height:auto;padding:0 1.125rem;border:1px solid transparent;border-radius:0.75rem;cursor:pointer;transition:all 0.2s ease;white-space:normal;background:var(--c-btn-secondary);color:var(--c-btn-solid);border-color:var(--c-btn-secondary-border);}.ds-secondary:hover:not(:disabled){background:color-mix(in srgb, var(--c-btn-secondary) 92%, var(--c-btn-solid));}.ds-secondary:focus-visible{outline:2px solid var(--c-primary);outline-offset:0.125rem;}.ds-secondary:active:not(:disabled){transform:translateY(0.0625rem);}.ds-secondary:disabled{background:var(--mantine-color-disabled);color:var(--mantine-color-disabled-color);border-color:transparent;cursor:not-allowed;}"
    },
    {
      "name": "Tool Tertiary Button",
