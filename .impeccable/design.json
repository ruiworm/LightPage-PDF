    },
    {
      "name": "Shared Card",
      "kind": "card",
      "refersTo": "card",
      "description": "已有默认 Card/Surface 的静态表面；工具分组不强制使用卡片。Source: Card.tsx/.css, Surface.css.",
      "html": "<div class=\"ds-card\">文件信息</div>",
      "css": ".ds-card{position:relative;background:var(--c-surface);color:var(--c-text);border:1px solid var(--c-border-subtle);border-radius:var(--radius-nav);padding:1.125rem 1.25rem;transition:border-color var(--motion-fast),transform var(--motion-fast);}"
    },
    {
      "name": "Tool Panel Header",
      "kind": "custom",
      "refersTo": "tool-header",
      "description": "共享工具标题、安静图标方块及圆形关闭操作。Source: ToolPanelHeader.tsx/.css, ActionIcon.tsx, accents.css.",
      "html": "<div class=\"ds-tool-header\"><div class=\"ds-tool-header-bar\"><span class=\"ds-tool-header-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6M8 13h8M8 17h6\"/></svg></span><span class=\"ds-tool-title\">文件工具</span></div><button type=\"button\" class=\"ds-tool-close\" aria-label=\"关闭工具\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></div>",
      "css": ".ds-tool-header{display:flex;align-items:center;gap:0.75rem;padding:1rem;background:var(--c-bg-raised);border-bottom:1px solid var(--c-border-subtle);}.ds-tool-header-bar{display:flex;align-items:center;gap:0.75rem;flex:1;min-width:0;color:var(--c-text);}.ds-tool-header-icon{display:inline-flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:0.625rem;background:var(--c-surface-sunken);color:var(--c-text-muted);flex-shrink:0;}.ds-tool-header-icon svg{width:1.125rem;height:1.125rem;}.ds-tool-title{font-family:inherit;font-size:1rem;font-weight:650;line-height:1.4;overflow-wrap:anywhere;min-width:0;}.ds-tool-close{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;flex-shrink:0;border:1px solid transparent;border-radius:50%;background:transparent;color:var(--c-text-muted);cursor:pointer;}.ds-tool-close:hover{background:var(--c-hover);color:var(--c-text);}.ds-tool-close:focus-visible{outline:2px solid var(--c-primary);outline-offset:0.125rem;}.ds-tool-close:active{transform:translateY(0.0625rem);}"
    },
    {
      "name": "Tool File Context",
      "kind": "custom",
      "refersTo": "tool-file-context",
      "description": "当前文件名称及元信息的紧凑信息块。Source: ToolInspector.css.",
      "html": "<div class=\"ds-file-context\"><span class=\"ds-file-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6M8 13h8M8 17h6\"/></svg></span><div class=\"ds-file-name\">示例文件.pdf<span class=\"ds-file-meta\">38.87 KB</span></div></div>",
      "css": ".ds-file-context{display:flex;gap:0.75rem;align-items:flex-start;padding:0.75rem;background:var(--c-input-bg);border:1px solid var(--c-border-subtle);border-radius:0.75rem;color:var(--c-text);font-family:inherit;font-size:0.8125rem;}.ds-file-icon{display:inline-flex;color:var(--c-text-muted);flex-shrink:0;padding-top:2px;}.ds-file-name{min-width:0;overflow-wrap:anywhere;line-height:1.55;font-weight:500;}.ds-file-meta{display:block;margin-top:0.25rem;color:var(--c-text-muted);font-size:0.6875rem;font-variant-numeric:tabular-nums;}"
    }
  ],
  "narrative": {
    "northStar": "简洁的设置面板",
    "overview": "这是已有编辑器视觉系统的延伸。界面以安静的中性色面、清楚的文字层级和克制的状态提示承载文件操作。保留轻页 PDF 名称、标志、顶部导航、文件栏及文档预览所形成的既有视觉关系。\n\n本次系统记录覆盖编辑器的共享视觉基础与已完成的工具检查面板。功能分组、文件上下文和操作区的具体组合见 [.impeccable/surfaces/tool-inspector.md](.impeccable/surfaces/tool-inspector.md)；它们不要求其他产品区域使用同一页面构图。",
    "keyCharacteristics": [
      "中性色面承载工作内容，蓝色提示选择、焦点和链接。",
      "深色主操作、轻量辅助操作，保持执行层级清楚。",
      "紧凑文字和柔和圆角适合持续操作的编辑器。",
      "工具设置按功能直接分组，文档预览保持可见。"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "消费组件使用现有语义变量；新增颜色须先进入 primitives.css，再建立所需语义映射。",
        "section": "colors"
      },
      {
        "name": "The Quiet Panel Rule",
        "body": "工具分组以间距、文字和细分隔线建立层级；需要 raised 表面时复用已有组件的层级样式。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用现有语义颜色变量，并把新 palette literal 留在 primitives.css。",
      "**Do** 保留轻页 PDF 名称、标志及编辑器既有导航与预览关系。",
      "**Do** 在工具检查面板复用本记录的文字层级、控件形状与分组内边距。",
      "**Do** 保留长文字换行、可见焦点、工具校验与结果操作状态。"
    ],
    "donts": [
      "**Don't** 为本次工具面板新增品牌配色、宣传式大标题或装饰性视觉材料。",
